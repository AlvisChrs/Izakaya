# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# Required in production; use long random secrets
ADMIN_TOKEN=replace-with-a-long-random-admin-token
KITCHEN_TOKEN=replace-with-a-long-random-kitchen-token

# Database
DB_PATH=./server/izakaya.db

# Frontend (Vite) - Client-side env vars (prefixed with VITE_)
VITE_SOCKET_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000